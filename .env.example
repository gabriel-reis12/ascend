# ==============================================================================
# ASCEND // VARIÁVEIS DE AMBIENTE (FRONTEND VITE / SUPABASE)
# ==============================================================================
# Copie este arquivo para .env.local para desenvolvimento local:
#   cp .env.example .env.local
#
# No Vercel (Preview e Produção), configure estas variáveis em:
#   Project Settings → Environment Variables
# ==============================================================================

# URL da instância Supabase (Projeto de Homologação/Beta ou Produção)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Chave pública anônima (anon public key) do Supabase
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# NOTA DE SEGURANÇA:
# NUNCA insira a chave service_role ou chaves secretas no frontend!
# O ASCEND não utiliza chaves de IA (OpenAI/Anthropic) nem gateways legados no client.
