/**
 * Retorna uma missão bônus diária do Sistema de forma determinística, imersiva e sem IA externa.
 * Considera a data de hoje e o histórico de títulos existentes para evitar repetições imediatas.
 */
export function generateBonusQuest(
  category: string,
  existingQuestTitles: string[] = [],
  hunterClass: HunterClass = 'Warrior'
): DeterministicBonusQuest {
  const categoryQuests = QUEST_CATALOG[category] || QUEST_CATALOG['Treino'];
  const classQuests = categoryQuests[hunterClass] || categoryQuests['default'] || Object.values(categoryQuests)[0];

  // Filtra itens já presentes nas missões de hoje para evitar duplicidade
  const normalizedExisting = existingQuestTitles.map(t => t.toLowerCase().trim());
  const availableQuests = classQuests.filter(q => 
    !normalizedExisting.some(ex => ex.includes(q.title.toLowerCase().slice(0, 20)))
  );

  const pool = availableQuests.length > 0 ? availableQuests : classQuests;

  // Seleciona um item baseado no dia do ano para consistência ao longo do dia,
  // ou índice determinístico
  const today = new Date();
  const dayOfYear = Math.floor(
    (today.getTime() - new Date(today.getFullYear(), 0, 0).getTime()) / (1000 * 60 * 60 * 24)
  );

  const selectedIndex = (dayOfYear + category.length) % pool.length;
  return pool[selectedIndex] || pool[0];
}

